{
  "schema": 1,
  "updated": "2026-10-27",
  "comment": "Data sources for every 3D Earth installation, in priority order. Installations re-read this file at each weather refresh, so editing it here (then publishing the data site) changes all of them without an app release. manifestUrls lists where this file lives; apps try those first next time, so the file can be moved.",
  "manifestUrls": [
    "https://vagdesign.github.io/3D-Earth/sources.json",
    "https://raw.githubusercontent.com/vagdesign/3D-Earth/main/sources/sources.json"
  ],
  "clouds": [
    {
      "id": "3dearth",
      "name": "3D Earth cloud service (EUMETSAT)",
      "url": "https://vagdesign.github.io/3D-Earth/clouds/{size}/clouds.jpg",
      "sizes": [
        "2048x1024",
        "4096x2048",
        "8192x4096"
      ],
      "status": "https://vagdesign.github.io/3D-Earth/clouds/status.json",
      "maxAgeHours": 9,
      "timeoutSeconds": 8
    },
    {
      "id": "matteason",
      "name": "Live cloud maps by Matt Eason",
      "url": "https://clouds.matteason.co.uk/images/{size}/clouds.jpg",
      "sizes": [
        "2048x1024",
        "4096x2048",
        "8192x4096"
      ],
      "maxAgeHours": 9,
      "timeoutSeconds": 8
    },
    {
      "id": "eumetsat-ir",
      "name": "EUMETSAT infrared world cloud map (direct)",
      "type": "wms-ir",
      "url": "https://view.eumetsat.int/geoserver/ows?service=WMS&request=GetMap&version=1.3.0&layers=mumi:worldcloudmap_ir108&styles=&format=image/png&crs=EPSG:4326&bbox={bbox}&width={half}&height={half}",
      "sizes": [
        "2048x1024"
      ],
      "levels": [
        72,
        178
      ],
      "gamma": 1.46,
      "gain": 0.77,
      "gamma2": 2.0,
      "maxAgeHours": 9,
      "timeoutSeconds": 30
    }
  ]
}
