<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF only for its imaging (WIC) classes: scaled JPEG decoding of huge NASA maps. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>3DEarth</AssemblyName>
    <RootNamespace>ThreeDEarth</RootNamespace>
    <Product>3D Earth</Product>
    <Company>Ax-Easy</Company>
    <Authors>Vangelis Makridakis; Claude (Anthropic)</Authors>
    <Copyright>© 2026 Ax-Easy - Vangelis Makridakis</Copyright>
    <Description>Live 3D Earth wallpaper</Description>
    <Version>0.7.2</Version>
    <ApplicationIcon>Earth.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- UseWPF drops System.IO and System.Net.Http from the implicit usings
         (to avoid clashes with WPF types); bring them back. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The 3D scene (HTML/JS/textures) ships next to the executable in .\web -->
    <Content Include="..\..\web\**\*" Exclude="..\..\web\data\**" LinkBase="web" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Earth.ico" LogicalName="Earth.ico" />
    <!-- Optional starting settings for new installs (Settings > Export produces this format). -->
    <Content Include="defaults.json" Condition="Exists('defaults.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
